#!/usr/bin/env bash
# Interactive project-local R (tools/r-env); state confined to tools/.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$HERE/env-local.sh"
export PATH="$R_ENV_PREFIX/bin:$PATH"
export R_LIBS="$R_ENV_PREFIX/lib/R/library"
exec "$R_ENV_PREFIX/bin/R" --no-save --no-restore "$@"
